# Keep the Collector build context small and reproducible.
# The Dockerfile does `COPY . .` then runs OCB, which only needs the Go modules
# under collector/ plus go.mod files. Everything below is either version-control
# cruft, build output, or unrelated project material — excluding it makes the
# image build faster and prevents stale local artifacts from leaking in.

# Version control
.git
.gitignore
.gitattributes
.github

# Build output (regenerated by OCB inside the image — must NOT be copied in)
_build/
**/bin/
*.tmp
_deltest.tmp

# Python build caches (the python/ source IS needed by the sdk-service image,
# so it is intentionally NOT excluded).
__pycache__/
**/__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
build/
dist/

# Docs, spec, paper, and other non-build material.
# NOTE: python/ and deploy/ are deliberately NOT excluded — the integration
# sdk-service image builds from the repo root and COPYs python/ and
# deploy/integration/sdk-service/. The collector build ignores them anyway.
paper/
docs/
otep/
spec/
model/
conformance/
*.md
*.pdf

# Secrets / local env (defense in depth — never bake these into an image)
.env
*.pem

# OS
.DS_Store
